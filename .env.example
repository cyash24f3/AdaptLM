ADAPTLM_PROFILE=fixture
ADAPTLM_DEVICE=cpu
ADAPTLM_DTYPE=float32
ADAPTLM_ATTENTION_IMPLEMENTATION=eager
ADAPTLM_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
# Filled from configs/model.json by default; never use a moving branch.
# ADAPTLM_REVISION=
# Optional configured local adapter directory, never accepted through HTTP.
# ADAPTLM_ADAPTER_PATH=models/main-adapter
ADAPTLM_DATA_DIR=datasets
ADAPTLM_REPORT_DIR=reports
# Set a strong local credential to unlock Dataset and Experiments.
ADAPTLM_ADMIN_TOKEN=replace-with-a-long-random-token
ADAPTLM_MAX_CHARS=3000
ADAPTLM_MAX_INPUT_TOKENS=4096
ADAPTLM_MAX_NEW_TOKENS=384
ADAPTLM_QUEUE_CAPACITY=2
ADAPTLM_QUEUE_TIMEOUT_SECONDS=60
ADAPTLM_OFFLINE=false
